APP_NAME=MproWave
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mprowave
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# DeepSeek AI Configuration (text-based MIDI/harmony/drum suggestions)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com

# Google Sign-In: the OAuth "Web" client ID from Google Cloud Console
# (APIs & Services > Credentials). Must match the client ID configured in
# mobile/src/config.ts. Leave blank during development to skip the
# audience check (any verified Google account will be accepted).
GOOGLE_CLIENT_ID=

# Audio Analysis Microservice (Demucs stem separation + basic-pitch audio-to-MIDI)
AUDIO_SERVICE_URL=http://localhost:8001

# Cloud Storage Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS Configuration
SANCTUM_STATEFUL_DOMAINS=localhost:8081
SESSION_DOMAIN=localhost
